{
  "brand": "paper-motion",
  "fonts": {
    "display": { "family": "Geist Serif", "weights": [400], "file": "assets/fonts/GeistSerif-Regular.woff2", "license": "OFL" },
    "text":    { "family": "Geist Mono", "weights": [400, 500], "file": "assets/fonts/GeistMono-Variable.woff2", "license": "OFL" },
    "mono":    { "family": "Geist Pixel", "weights": [400], "file": "assets/fonts/GeistPixel-Square.woff2", "license": "OFL" }
  },
  "colors": {
    "ground":  { "hex": "#000000", "role": "every frame" },
    "figure":  { "hex": "#FFFFFF", "role": "primary type and the cursor" },
    "muted":   { "hex": "#8A8A8A", "role": "taglines and secondary text" },
    "surface": { "hex": "#0A0A0A", "role": "panels and terminal windows" },
    "accent":  { "hex": "#E9E4D8", "role": "paper: a warm white for one moment" }
  },
  "ramp": ["#000000", "#2E2E2E", "#5F7A86", "#8EA3AD"],
  "mode": "dark",
  "type": {
    "reference": 1080,
    "display": { "font": "display", "weight": 400, "size": 220, "lineHeight": 0.95, "tracking": "-0.02em" },
    "title":   { "font": "display", "weight": 400, "size": 96,  "lineHeight": 1.0,  "tracking": "-0.02em" },
    "body":    { "font": "text",    "weight": 400, "size": 26,  "lineHeight": 1.5,  "tracking": "0em" },
    "caption": { "font": "text",    "weight": 500, "size": 20,  "lineHeight": 1.3,  "tracking": "0em" }
  },
  "shape": { "language": "hard", "radius": 12, "stroke": 1 },
  "wordmark": {
    "text": "paper-motion", "font": "display", "weight": 400, "tracking": "-0.02em",
    "files": { "onLight": "assets/wordmark-on-light.png", "onDark": "assets/wordmark-on-dark.png" },
    "logo": null
  }
}
