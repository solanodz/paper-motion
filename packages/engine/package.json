  "bugs": {
    "url": "https://github.com/solanodz/paper-motion/issues"
  },
  "license": "MIT",
  "author": "Solano de Zuasnabar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solanodz/paper-motion.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "bin": {
    "pamo": "bin/pamo.mjs",
