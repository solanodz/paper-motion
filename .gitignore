node_modules/
.DS_Store

# Local work: pieces in progress (one holds a copyrighted instrumental) and their outputs
works/
renders/
stills/

# Personal shader library while it is being moved into examples/paper-motion-brand (spec step 11)
library/

# Example brand: the shader-set loops are local (works/shader-set/renders); the sheet exports are regenerated
examples/paper-motion-brand/brand/shader-set/renders
examples/paper-motion-brand/brand/sheet/sheet.png
examples/paper-motion-brand/brand/sheet/sheet.pdf

# Interview option boards are throwaway
**/brand/.interview/

# Shader sets: shots, boards and shot.js are rebuilt by `pamo shader-set build`
**/brand/shader-set/shots/
**/brand/shader-set/boards/
**/brand/shader-set/shot.js

# Audio never goes in the repo: sound samples are rebuilt by `pamo sound-samples`, keystroke banks and music stay local
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
**/brand/sound/sounds.json
**/brand/sound/keys/

# The default keystroke bank ships in the npm package only (built by packages/engine/scripts/fetch-keys.mjs)
packages/engine/assets/keys/
