{
  "$schema": "../../schema.json",
  "id": "word-rise",
  "type": "text",
  "title": "Word rise",
  "summary": "Words rise one by one from behind a mask line.",
  "tags": [
    "text",
    "neutral",
    "editorial"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "export": "wordRise",
  "signature": "wordRise(el, t, { start, each, duration, curve })",
  "params": [
    {
      "name": "start",
      "type": "number",
      "default": 0,
      "description": "start time in seconds",
      "hidden": true
    },
    {
      "name": "each",
      "type": "number",
      "default": 0.08,
      "description": "delay between items (s)",
      "min": 0,
      "max": 0.3,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.5,
      "description": "length of the transition in seconds; springs use it to keep their feel",
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "group": "main"
    },
    {
      "name": "curve",
      "type": "function",
      "default": "ease.outExpo",
      "description": "easing function (from `ease`)",
      "control": "ease",
      "group": "main"
    }
  ],
  "install": {
    "kind": "code"
  },
  "files": [
    {
      "from": "packages/engine/runtime/moves/word-rise.js",
      "to": "moves/word-rise.js"
    }
  ],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { wordRise } from './moves/word-rise.js';\n\ns.update((t) => wordRise(el, t, { start: 0.5 }));",
  "notes": [
    "Words rise one by one from behind a mask line."
  ],
  "preview": {
    "video": "previews/word-rise.webm",
    "poster": "previews/word-rise.jpg"
  }
}
