{
  "$schema": "../../schema.json",
  "id": "dm",
  "type": "font-pair",
  "title": "DM Serif Display + DM Sans",
  "summary": "Free font pair (Google Fonts): friendly, premium, lifestyle.",
  "tags": [
    "font-pair",
    "friendly",
    "premium",
    "lifestyle",
    "serif"
  ],
  "version": "1.0.0",
  "license": "OFL",
  "params": [
    {
      "name": "display",
      "type": "string",
      "default": "DM Serif Display",
      "description": "headline family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "text",
      "type": "string",
      "default": "DM Sans",
      "description": "body family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "mono",
      "type": "string",
      "default": "DM Mono",
      "description": "labels and code family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "displayWeight",
      "type": "number",
      "default": 400,
      "description": "headline weight",
      "group": "main",
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "name": "tracking",
      "type": "number",
      "default": -0.01,
      "description": "headline letter spacing (em)",
      "group": "main",
      "min": -0.1,
      "max": 0.1,
      "step": 0.005
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "fonts": {
        "display": {
          "family": "DM Serif Display",
          "weights": [
            400
          ],
          "css": "https://fonts.googleapis.com/css2?family=DM+Serif+Display:wght@400&display=swap",
          "license": "OFL"
        },
        "text": {
          "family": "DM Sans",
          "weights": [
            400,
            500
          ],
          "css": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&display=swap",
          "license": "OFL"
        },
        "mono": {
          "family": "DM Mono",
          "weights": [
            400
          ],
          "css": "https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&display=swap",
          "license": "OFL"
        }
      },
      "type": {
        "reference": 1080,
        "display": {
          "font": "display",
          "weight": 400,
          "size": 200,
          "lineHeight": 0.95,
          "tracking": "-0.01em"
        },
        "title": {
          "font": "display",
          "weight": 400,
          "size": 96,
          "lineHeight": 1,
          "tracking": "-0.01em"
        },
        "body": {
          "font": "text",
          "weight": 400,
          "size": 28,
          "lineHeight": 1.45,
          "tracking": "0em"
        },
        "caption": {
          "font": "mono",
          "weight": 400,
          "size": 20,
          "lineHeight": 1.3,
          "tracking": "0em"
        }
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0",
    "fonts": [
      "DM Serif Display",
      "DM Sans",
      "DM Mono"
    ]
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand(); // loads the fonts before the first frame\nB.style(title, 'display');\nB.style(caption, 'caption');",
  "notes": [
    "Fonts load from Google Fonts at render time; for offline renders, download the files into brand/assets/fonts/ and set `file` instead of `css`.",
    "Sizes are for a 1080 px short side; B.type() scales them for other formats."
  ],
  "preview": {
    "video": "previews/dm.webm",
    "poster": "previews/dm.jpg"
  }
}
