{
  "$schema": "../../schema.json",
  "id": "geist-serif",
  "type": "font-pair",
  "title": "Geist Serif + Geist + Geist Mono",
  "summary": "paper-motion.app's own pair: Geist Serif headlines (self-hosted), Geist text, Geist Mono labels; editorial and technical at once.",
  "tags": [
    "font-pair",
    "editorial",
    "technical",
    "serif",
    "paper-motion"
  ],
  "version": "1.0.0",
  "license": "OFL",
  "params": [
    {
      "name": "display",
      "type": "string",
      "default": "Geist Serif",
      "description": "headline family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "text",
      "type": "string",
      "default": "Geist",
      "description": "body family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "mono",
      "type": "string",
      "default": "Geist Mono",
      "description": "labels and code family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "displayWeight",
      "type": "number",
      "default": 400,
      "description": "headline weight",
      "group": "main",
      "min": 400,
      "max": 400,
      "step": 100
    },
    {
      "name": "tracking",
      "type": "number",
      "default": -0.02,
      "description": "headline letter spacing (em)",
      "group": "main",
      "min": -0.1,
      "max": 0.1,
      "step": 0.005
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "fonts": {
        "display": {
          "family": "Geist Serif",
          "weights": [
            400
          ],
          "css": "https://paper-motion.vercel.app/fonts/geist-serif.css",
          "license": "OFL"
        },
        "text": {
          "family": "Geist",
          "weights": [
            400,
            500
          ],
          "css": "https://fonts.googleapis.com/css2?family=Geist:wght@400;500&display=swap",
          "license": "OFL"
        },
        "mono": {
          "family": "Geist Mono",
          "weights": [
            400,
            500
          ],
          "css": "https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap",
          "license": "OFL"
        }
      },
      "type": {
        "reference": 1080,
        "display": {
          "font": "display",
          "weight": 400,
          "size": 200,
          "lineHeight": 0.95,
          "tracking": "-0.02em"
        },
        "title": {
          "font": "display",
          "weight": 400,
          "size": 96,
          "lineHeight": 1,
          "tracking": "-0.02em"
        },
        "body": {
          "font": "text",
          "weight": 400,
          "size": 28,
          "lineHeight": 1.45,
          "tracking": "0em"
        },
        "caption": {
          "font": "mono",
          "weight": 400,
          "size": 20,
          "lineHeight": 1.3,
          "tracking": "0em"
        }
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0",
    "fonts": [
      "Geist",
      "Geist",
      "Geist Mono"
    ]
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand(); // loads the fonts before the first frame\nB.style(title, 'display');\nB.style(caption, 'caption');",
  "notes": [
    "Geist Serif is served by paper-motion.app (it is not on Google Fonts); renders need network, or copy /fonts/GeistSerif-Regular.woff2 into brand/assets/fonts and point the css at it.",
    "Geist Serif ships in one weight (400)."
  ],
  "preview": {
    "video": "previews/geist.webm",
    "poster": "previews/geist.jpg"
  },
  "mood": [
    "editorial",
    "technical",
    "minimal"
  ],
  "voice": "serif",
  "when": [
    "the brand should feel like paper-motion.app itself",
    "a serif headline over a technical body"
  ]
}