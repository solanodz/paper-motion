{
  "$schema": "../../schema.json",
  "id": "space",
  "type": "font-pair",
  "title": "Space Grotesk + Space Mono",
  "summary": "Free font pair (Google Fonts): quirky, tech, startup.",
  "tags": [
    "font-pair",
    "quirky",
    "tech",
    "startup",
    "sans"
  ],
  "version": "1.0.0",
  "license": "OFL",
  "params": [
    {
      "name": "display",
      "type": "string",
      "default": "Space Grotesk",
      "description": "headline family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "text",
      "type": "string",
      "default": "Space Grotesk",
      "description": "body family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "mono",
      "type": "string",
      "default": "Space Mono",
      "description": "labels and code family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "displayWeight",
      "type": "number",
      "default": 600,
      "description": "headline weight",
      "group": "main",
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "name": "tracking",
      "type": "number",
      "default": -0.03,
      "description": "headline letter spacing (em)",
      "group": "main",
      "min": -0.1,
      "max": 0.1,
      "step": 0.005
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "fonts": {
        "display": {
          "family": "Space Grotesk",
          "weights": [
            500,
            700
          ],
          "css": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap",
          "license": "OFL"
        },
        "text": {
          "family": "Space Grotesk",
          "weights": [
            400
          ],
          "css": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400&display=swap",
          "license": "OFL"
        },
        "mono": {
          "family": "Space Mono",
          "weights": [
            400
          ],
          "css": "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400&display=swap",
          "license": "OFL"
        }
      },
      "type": {
        "reference": 1080,
        "display": {
          "font": "display",
          "weight": 600,
          "size": 200,
          "lineHeight": 0.95,
          "tracking": "-0.03em"
        },
        "title": {
          "font": "display",
          "weight": 600,
          "size": 96,
          "lineHeight": 1,
          "tracking": "-0.03em"
        },
        "body": {
          "font": "text",
          "weight": 400,
          "size": 28,
          "lineHeight": 1.45,
          "tracking": "0em"
        },
        "caption": {
          "font": "mono",
          "weight": 400,
          "size": 20,
          "lineHeight": 1.3,
          "tracking": "0em"
        }
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0",
    "fonts": [
      "Space Grotesk",
      "Space Grotesk",
      "Space Mono"
    ]
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand(); // loads the fonts before the first frame\nB.style(title, 'display');\nB.style(caption, 'caption');",
  "notes": [
    "Fonts load from Google Fonts at render time; for offline renders, download the files into brand/assets/fonts/ and set `file` instead of `css`.",
    "Sizes are for a 1080 px short side; B.type() scales them for other formats."
  ],
  "preview": {
    "video": "previews/space.webm",
    "poster": "previews/space.jpg"
  },
  "mood": [
    "technical",
    "playful"
  ],
  "voice": "sans",
  "when": [
    "the brand should sound technical, playful",
    "a sans headline voice with a plain body face"
  ]
}
