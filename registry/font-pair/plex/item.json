{
  "$schema": "../../schema.json",
  "id": "plex",
  "type": "font-pair",
  "title": "IBM Plex Serif + Plex Sans",
  "summary": "Free font pair (Google Fonts): serious, corporate, documentation.",
  "tags": [
    "font-pair",
    "serious",
    "corporate",
    "documentation",
    "serif"
  ],
  "version": "1.0.0",
  "license": "OFL",
  "params": [
    {
      "name": "display",
      "type": "string",
      "default": "IBM Plex Serif",
      "description": "headline family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "text",
      "type": "string",
      "default": "IBM Plex Sans",
      "description": "body family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "mono",
      "type": "string",
      "default": "IBM Plex Mono",
      "description": "labels and code family",
      "group": "main",
      "control": "font"
    },
    {
      "name": "displayWeight",
      "type": "number",
      "default": 500,
      "description": "headline weight",
      "group": "main",
      "min": 100,
      "max": 900,
      "step": 100
    },
    {
      "name": "tracking",
      "type": "number",
      "default": -0.01,
      "description": "headline letter spacing (em)",
      "group": "main",
      "min": -0.1,
      "max": 0.1,
      "step": 0.005
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "fonts": {
        "display": {
          "family": "IBM Plex Serif",
          "weights": [
            400,
            600
          ],
          "css": "https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@400;600&display=swap",
          "license": "OFL"
        },
        "text": {
          "family": "IBM Plex Sans",
          "weights": [
            400,
            500
          ],
          "css": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&display=swap",
          "license": "OFL"
        },
        "mono": {
          "family": "IBM Plex Mono",
          "weights": [
            400
          ],
          "css": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&display=swap",
          "license": "OFL"
        }
      },
      "type": {
        "reference": 1080,
        "display": {
          "font": "display",
          "weight": 500,
          "size": 200,
          "lineHeight": 0.95,
          "tracking": "-0.01em"
        },
        "title": {
          "font": "display",
          "weight": 500,
          "size": 96,
          "lineHeight": 1,
          "tracking": "-0.01em"
        },
        "body": {
          "font": "text",
          "weight": 400,
          "size": 28,
          "lineHeight": 1.45,
          "tracking": "0em"
        },
        "caption": {
          "font": "mono",
          "weight": 400,
          "size": 20,
          "lineHeight": 1.3,
          "tracking": "0em"
        }
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0",
    "fonts": [
      "IBM Plex Serif",
      "IBM Plex Sans",
      "IBM Plex Mono"
    ]
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand(); // loads the fonts before the first frame\nB.style(title, 'display');\nB.style(caption, 'caption');",
  "notes": [
    "Fonts load from Google Fonts at render time; for offline renders, download the files into brand/assets/fonts/ and set `file` instead of `css`.",
    "Sizes are for a 1080 px short side; B.type() scales them for other formats."
  ],
  "preview": {
    "video": "previews/plex.webm",
    "poster": "previews/plex.jpg"
  },
  "mood": [
    "technical",
    "editorial",
    "calm"
  ],
  "voice": "serif",
  "when": [
    "the brand should sound technical, editorial, calm",
    "a serif headline voice with a plain body face"
  ]
}
