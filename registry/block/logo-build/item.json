{
  "$schema": "../../schema.json",
  "version": "1.0.0",
  "license": "MIT",
  "id": "logo-build",
  "type": "block",
  "title": "Logo build",
  "summary": "The wordmark builds itself: each letter traces its outline, the fill rises from the baseline, and the domain lands under it.",
  "tags": [
    "block",
    "brand",
    "wordmark",
    "logo",
    "outline",
    "end-card"
  ],
  "params": [
    {
      "name": "background",
      "type": "string",
      "default": "",
      "description": "a background id from the registry; empty uses the brand's first",
      "group": "advanced",
      "control": "select"
    },
    {
      "name": "word",
      "type": "string",
      "default": "",
      "description": "empty takes the brand's wordmark",
      "group": "main",
      "control": "text"
    },
    {
      "name": "domain",
      "type": "string",
      "default": "paper-motion.app",
      "description": "domain",
      "group": "main",
      "control": "text"
    },
    {
      "name": "format",
      "type": "enum",
      "default": "1920x1080",
      "options": [
        "1920x1080",
        "1080x1920",
        "1080x1080"
      ],
      "description": "output size; the layout recomposes for each",
      "group": "main",
      "control": "segmented"
    }
  ],
  "install": {
    "kind": "scene"
  },
  "files": [
    {
      "from": "registry/block/logo-build/scene.html",
      "to": "pieces/logo-build/scene.html"
    },
    {
      "from": "registry/block/logo-build/brief.md",
      "to": "pieces/logo-build/brief.md"
    }
  ],
  "requires": {
    "engine": ">=0.2.6"
  },
  "usage": "npx paper-motion add logo-build --name my-logo-build\n# edit CONFIG in pieces/my-logo-build/scene.html, then:\nnpx paper-motion render pieces/my-logo-build/scene.html --motion-blur 5",
  "notes": [
    "Wired to the brand folder: needs brand/tokens.json (a palette and a font pair work) and, for the field, a shader-set entry.",
    "Recomposes for 16:9, 9:16 and 1:1: set `format` and the layout and camera follow."
  ],
  "related": [
    "svg-logo",
    "text-mask"
  ],
  "preview": {
    "video": "previews/logo-build.webm",
    "poster": "previews/logo-build.jpg",
    "at": 4.6,
    "values": {}
  },
  "mood": [
    "technical",
    "calm"
  ],
  "duration": 5,
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "beats": [
    {
      "name": "Trace",
      "from": 0.2,
      "to": 1.7,
      "what": "trace"
    },
    {
      "name": "Fill",
      "from": 1.3,
      "to": 2.5,
      "what": "fill"
    },
    {
      "name": "Domain",
      "from": 2.7,
      "to": 3.3000000000000003,
      "what": "domain"
    },
    {
      "name": "Hold",
      "from": 3.3000000000000003,
      "to": 5,
      "what": "hold"
    }
  ],
  "when": [
    "the end card",
    "a logo sting"
  ]
}
