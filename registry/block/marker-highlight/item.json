{
  "$schema": "../../schema.json",
  "version": "1.0.0",
  "license": "MIT",
  "id": "marker-highlight",
  "type": "block",
  "title": "Marker highlight",
  "summary": "A sentence lands word by word, then a tilted marker sweeps behind the key words, which turn dark exactly where it passes.",
  "tags": [
    "block",
    "text",
    "highlight",
    "marker",
    "emphasis"
  ],
  "params": [
    {
      "name": "background",
      "type": "string",
      "default": "",
      "description": "a background id from the registry; empty uses the brand's first",
      "group": "advanced",
      "control": "select"
    },
    {
      "name": "before",
      "type": "string",
      "default": "Your agent directs",
      "description": "before",
      "group": "main",
      "control": "text"
    },
    {
      "name": "mark",
      "type": "string",
      "default": "every frame.",
      "description": "the words the marker sweeps",
      "group": "main",
      "control": "text"
    },
    {
      "name": "after",
      "type": "string",
      "default": "",
      "description": "after",
      "group": "main",
      "control": "text"
    },
    {
      "name": "format",
      "type": "enum",
      "default": "1920x1080",
      "options": [
        "1920x1080",
        "1080x1920",
        "1080x1080"
      ],
      "description": "output size; the layout recomposes for each",
      "group": "main",
      "control": "segmented"
    }
  ],
  "install": {
    "kind": "scene"
  },
  "files": [
    {
      "from": "registry/block/marker-highlight/scene.html",
      "to": "pieces/marker-highlight/scene.html"
    },
    {
      "from": "registry/block/marker-highlight/brief.md",
      "to": "pieces/marker-highlight/brief.md"
    }
  ],
  "requires": {
    "engine": ">=0.2.6"
  },
  "usage": "npx paper-motion add marker-highlight --name my-marker-highlight\n# edit CONFIG in pieces/my-marker-highlight/scene.html, then:\nnpx paper-motion render pieces/my-marker-highlight/scene.html --motion-blur 5",
  "notes": [
    "Wired to the brand folder: needs brand/tokens.json (a palette and a font pair work) and, for the field, a shader-set entry.",
    "Recomposes for 16:9, 9:16 and 1:1: set `format` and the layout and camera follow."
  ],
  "related": [
    "word-swap",
    "circle-mark"
  ],
  "preview": {
    "video": "previews/marker-highlight.webm",
    "poster": "previews/marker-highlight.jpg",
    "at": 4.5,
    "values": {}
  },
  "mood": [
    "warm",
    "bold"
  ],
  "duration": 4.8,
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "beats": [
    {
      "name": "Words",
      "from": 0.2,
      "to": 1.2,
      "what": "words"
    },
    {
      "name": "Sweep",
      "from": 1.6,
      "to": 2.3,
      "what": "sweep"
    },
    {
      "name": "Hold",
      "from": 2.3,
      "to": 4.8,
      "what": "hold"
    }
  ],
  "when": [
    "the one phrase that matters",
    "a promise or tagline"
  ]
}
