{
  "$schema": "../../schema.json",
  "version": "1.0.0",
  "license": "MIT",
  "id": "terminal-run",
  "type": "block",
  "title": "Terminal run",
  "summary": "A command types itself, a spinner works, the output streams in with its checks and the file it made lights up.",
  "tags": [
    "block",
    "code",
    "terminal",
    "cli",
    "install",
    "developer"
  ],
  "params": [
    {
      "name": "background",
      "type": "string",
      "default": "",
      "description": "a background id from the registry; empty uses the brand's first",
      "group": "advanced",
      "control": "select"
    },
    {
      "name": "cwd",
      "type": "string",
      "default": "~/launch",
      "description": "cwd",
      "group": "main",
      "control": "text"
    },
    {
      "name": "command",
      "type": "string",
      "default": "npx paper-motion add push-in",
      "description": "command",
      "group": "main",
      "control": "text"
    },
    {
      "name": "working",
      "type": "string",
      "default": "Resolving push-in",
      "description": "working",
      "group": "main",
      "control": "text"
    },
    {
      "name": "format",
      "type": "enum",
      "default": "1920x1080",
      "options": [
        "1920x1080",
        "1080x1920",
        "1080x1080"
      ],
      "description": "output size; the layout recomposes for each",
      "group": "main",
      "control": "segmented"
    }
  ],
  "install": {
    "kind": "scene"
  },
  "files": [
    {
      "from": "registry/block/terminal-run/scene.html",
      "to": "pieces/terminal-run/scene.html"
    },
    {
      "from": "registry/block/terminal-run/brief.md",
      "to": "pieces/terminal-run/brief.md"
    }
  ],
  "requires": {
    "engine": ">=0.2.6"
  },
  "usage": "npx paper-motion add terminal-run --name my-terminal-run\n# edit CONFIG in pieces/my-terminal-run/scene.html, then:\nnpx paper-motion render pieces/my-terminal-run/scene.html --motion-blur 5",
  "notes": [
    "Wired to the brand folder: needs brand/tokens.json (a palette and a font pair work) and, for the field, a shader-set entry.",
    "Recomposes for 16:9, 9:16 and 1:1: set `format` and the layout and camera follow."
  ],
  "related": [
    "code-type",
    "toast-stack"
  ],
  "preview": {
    "video": "previews/terminal-run.webm",
    "poster": "previews/terminal-run.jpg",
    "at": 5.4,
    "values": {
      "command": "npx paper-motion add push-in"
    }
  },
  "mood": [
    "technical"
  ],
  "duration": 6.2,
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "beats": [
    {
      "name": "Arrive",
      "from": 0,
      "to": 0.6,
      "what": "arrive"
    },
    {
      "name": "Type",
      "from": 0.6,
      "to": 1.5,
      "what": "type"
    },
    {
      "name": "Run",
      "from": 1.65,
      "to": 2.5,
      "what": "run"
    },
    {
      "name": "Output",
      "from": 2.5,
      "to": 3.7,
      "what": "output"
    },
    {
      "name": "Result",
      "from": 4,
      "to": 4.6,
      "what": "result"
    },
    {
      "name": "Hold",
      "from": 4.6,
      "to": 6.2,
      "what": "hold"
    }
  ],
  "when": [
    "install and run steps",
    "a CLI doing its job"
  ],
  "needs": [
    {
      "kind": "command",
      "fill": {
        "cwd": "$cwd",
        "command": "$command",
        "working": "$working",
        "output": "$output"
      }
    }
  ]
}
