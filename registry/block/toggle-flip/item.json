{
  "$schema": "../../schema.json",
  "version": "1.0.0",
  "license": "MIT",
  "id": "toggle-flip",
  "type": "block",
  "title": "Toggle flip",
  "summary": "A cursor flips a switch and the whole interface changes theme in a circle that spreads out from the switch.",
  "tags": [
    "block",
    "ui",
    "toggle",
    "theme",
    "dark-mode",
    "reveal"
  ],
  "params": [
    {
      "name": "background",
      "type": "string",
      "default": "",
      "description": "a background id from the registry; empty uses the brand's first",
      "group": "advanced",
      "control": "select"
    },
    {
      "name": "title",
      "type": "string",
      "default": "Appearance",
      "description": "title",
      "group": "main",
      "control": "text"
    },
    {
      "name": "toggle",
      "type": "string",
      "default": "Light mode",
      "description": "toggle",
      "group": "main",
      "control": "text"
    },
    {
      "name": "format",
      "type": "enum",
      "default": "1920x1080",
      "options": [
        "1920x1080",
        "1080x1920",
        "1080x1080"
      ],
      "description": "output size; the layout recomposes for each",
      "group": "main",
      "control": "segmented"
    }
  ],
  "install": {
    "kind": "scene"
  },
  "files": [
    {
      "from": "registry/block/toggle-flip/scene.html",
      "to": "pieces/toggle-flip/scene.html"
    },
    {
      "from": "registry/block/toggle-flip/brief.md",
      "to": "pieces/toggle-flip/brief.md"
    }
  ],
  "requires": {
    "engine": ">=0.2.6"
  },
  "usage": "npx paper-motion add toggle-flip --name my-toggle-flip\n# edit CONFIG in pieces/my-toggle-flip/scene.html, then:\nnpx paper-motion render pieces/my-toggle-flip/scene.html --motion-blur 5",
  "notes": [
    "Wired to the brand folder: needs brand/tokens.json (a palette and a font pair work) and, for the field, a shader-set entry.",
    "Recomposes for 16:9, 9:16 and 1:1: set `format` and the layout and camera follow."
  ],
  "related": [
    "form-fill",
    "iris"
  ],
  "preview": {
    "video": "previews/toggle-flip.webm",
    "poster": "previews/toggle-flip.jpg",
    "at": 2.4,
    "values": {}
  },
  "mood": [
    "playful",
    "minimal"
  ],
  "duration": 5.2,
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "beats": [
    {
      "name": "Reach",
      "from": 0.4,
      "to": 1.1,
      "what": "reach"
    },
    {
      "name": "Click",
      "from": 1.2,
      "to": 1.7999999999999998,
      "what": "click"
    },
    {
      "name": "Sweep",
      "from": 1.35,
      "to": 2.5,
      "what": "sweep"
    },
    {
      "name": "Hold",
      "from": 2.5,
      "to": 5.2,
      "what": "hold"
    }
  ],
  "when": [
    "a setting that changes everything",
    "light and dark mode"
  ],
  "needs": [
    {
      "kind": "toggle",
      "fill": {
        "title": "$title",
        "toggle": "$toggle",
        "rows": "$rows"
      }
    }
  ]
}
