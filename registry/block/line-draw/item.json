{
  "$schema": "../../schema.json",
  "version": "1.0.0",
  "license": "MIT",
  "id": "line-draw",
  "type": "block",
  "title": "Line draw",
  "summary": "A trend line draws with a dot riding its tip and the camera close on it; at the peak a label pops and the camera pulls back on the climb.",
  "tags": [
    "block",
    "data",
    "chart",
    "line",
    "trend",
    "growth"
  ],
  "params": [
    {
      "name": "background",
      "type": "string",
      "default": "",
      "description": "a background id from the registry; empty uses the brand's first",
      "group": "advanced",
      "control": "select"
    },
    {
      "name": "title",
      "type": "string",
      "default": "Brands made with paper-motion",
      "description": "title",
      "group": "main",
      "control": "text"
    },
    {
      "name": "tag",
      "type": "string",
      "default": "+42% this month",
      "description": "tag",
      "group": "main",
      "control": "text"
    },
    {
      "name": "format",
      "type": "enum",
      "default": "1920x1080",
      "options": [
        "1920x1080",
        "1080x1920",
        "1080x1080"
      ],
      "description": "output size; the layout recomposes for each",
      "group": "main",
      "control": "segmented"
    }
  ],
  "install": {
    "kind": "scene"
  },
  "files": [
    {
      "from": "registry/block/line-draw/scene.html",
      "to": "pieces/line-draw/scene.html"
    },
    {
      "from": "registry/block/line-draw/brief.md",
      "to": "pieces/line-draw/brief.md"
    }
  ],
  "requires": {
    "engine": ">=0.2.6"
  },
  "usage": "npx paper-motion add line-draw --name my-line-draw\n# edit CONFIG in pieces/my-line-draw/scene.html, then:\nnpx paper-motion render pieces/my-line-draw/scene.html --motion-blur 5",
  "notes": [
    "Wired to the brand folder: needs brand/tokens.json (a palette and a font pair work) and, for the field, a shader-set entry.",
    "Recomposes for 16:9, 9:16 and 1:1: set `format` and the layout and camera follow."
  ],
  "related": [
    "bar-grow",
    "donut-fill"
  ],
  "preview": {
    "video": "previews/line-draw.webm",
    "poster": "previews/line-draw.jpg",
    "at": 5.3,
    "values": {}
  },
  "mood": [
    "bold",
    "calm"
  ],
  "duration": 5.5,
  "formats": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "beats": [
    {
      "name": "Arrive",
      "from": 0,
      "to": 0.7,
      "what": "arrive"
    },
    {
      "name": "Draw",
      "from": 0.6,
      "to": 3.4,
      "what": "draw"
    },
    {
      "name": "Peak",
      "from": 3.4,
      "to": 4,
      "what": "peak"
    },
    {
      "name": "Pull back",
      "from": 3.4,
      "to": 5.2,
      "what": "pull back"
    }
  ],
  "when": [
    "a curve that keeps climbing",
    "momentum"
  ]
}
