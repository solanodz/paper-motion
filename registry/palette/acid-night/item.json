{
  "$schema": "../../schema.json",
  "id": "acid-night",
  "type": "palette",
  "title": "Acid night",
  "summary": "Dark palette: black with acid lime; loud, tech launch, nightlife.",
  "tags": [
    "palette",
    "dark",
    "loud",
    "tech",
    "launch",
    "nightlife"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "ground",
      "type": "color",
      "default": "#0B0B0A",
      "description": "every frame",
      "group": "main"
    },
    {
      "name": "figure",
      "type": "color",
      "default": "#F4F4EE",
      "description": "primary type",
      "group": "main"
    },
    {
      "name": "muted",
      "type": "color",
      "default": "#8C8C84",
      "description": "secondary text",
      "group": "main"
    },
    {
      "name": "surface",
      "type": "color",
      "default": "#161614",
      "description": "panels and cards",
      "group": "main"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#C8F04A",
      "description": "one moment of emphasis",
      "group": "main"
    },
    {
      "name": "ramp",
      "type": "colors",
      "default": [
        "#0B0B0A",
        "#2A2D1E",
        "#7C9E25",
        "#C8F04A"
      ],
      "description": "four steps from ground toward accent, for shaders and gradients",
      "group": "main",
      "maxItems": 8
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "colors": {
        "ground": {
          "hex": "#0B0B0A",
          "role": "every frame"
        },
        "figure": {
          "hex": "#F4F4EE",
          "role": "primary type"
        },
        "muted": {
          "hex": "#8C8C84",
          "role": "secondary text"
        },
        "surface": {
          "hex": "#161614",
          "role": "panels and cards"
        },
        "accent": {
          "hex": "#C8F04A",
          "role": "one moment of emphasis"
        }
      },
      "ramp": [
        "#0B0B0A",
        "#2A2D1E",
        "#7C9E25",
        "#C8F04A"
      ],
      "mode": "dark"
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\nconst s = scene({ background: B.color('ground') });\ntitle.style.color = B.color('figure');",
  "notes": [
    "Contrast: figure on ground 17.8:1, muted on ground 5.8:1.",
    "Use the accent for one moment, not everywhere."
  ],
  "preview": {
    "video": "previews/acid-night.webm",
    "poster": "previews/acid-night.jpg"
  },
  "colors": [
    "#0b0b0a",
    "#f4f4ee",
    "#c8f04a"
  ],
  "mode": "dark",
  "mood": [
    "bold",
    "raw",
    "technical"
  ],
  "when": [
    "a dark piece that should feel bold, raw, technical",
    "you want roles (ground, figure, accent) rather than loose colors"
  ]
}
