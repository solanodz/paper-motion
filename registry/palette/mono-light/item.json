{
  "$schema": "../../schema.json",
  "id": "mono-light",
  "type": "palette",
  "title": "Mono light",
  "summary": "Light palette: white and greys with black; neutral, minimal, documentation.",
  "tags": [
    "palette",
    "light",
    "neutral",
    "minimal",
    "documentation"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "ground",
      "type": "color",
      "default": "#FFFFFF",
      "description": "every frame",
      "group": "main"
    },
    {
      "name": "figure",
      "type": "color",
      "default": "#111111",
      "description": "primary type",
      "group": "main"
    },
    {
      "name": "muted",
      "type": "color",
      "default": "#777777",
      "description": "secondary text",
      "group": "main"
    },
    {
      "name": "surface",
      "type": "color",
      "default": "#F3F3F3",
      "description": "panels and cards",
      "group": "main"
    },
    {
      "name": "accent",
      "type": "color",
      "default": "#111111",
      "description": "one moment of emphasis",
      "group": "main"
    },
    {
      "name": "ramp",
      "type": "colors",
      "default": [
        "#FFFFFF",
        "#E5E5E5",
        "#A3A3A3",
        "#111111"
      ],
      "description": "four steps from ground toward accent, for shaders and gradients",
      "group": "main",
      "maxItems": 8
    }
  ],
  "install": {
    "kind": "tokens",
    "entry": {
      "colors": {
        "ground": {
          "hex": "#FFFFFF",
          "role": "every frame"
        },
        "figure": {
          "hex": "#111111",
          "role": "primary type"
        },
        "muted": {
          "hex": "#777777",
          "role": "secondary text"
        },
        "surface": {
          "hex": "#F3F3F3",
          "role": "panels and cards"
        },
        "accent": {
          "hex": "#111111",
          "role": "one moment of emphasis"
        }
      },
      "ramp": [
        "#FFFFFF",
        "#E5E5E5",
        "#A3A3A3",
        "#111111"
      ],
      "mode": "light"
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\nconst s = scene({ background: B.color('ground') });\ntitle.style.color = B.color('figure');",
  "notes": [
    "Contrast: figure on ground 18.9:1, muted on ground 4.5:1.",
    "Use the accent for one moment, not everywhere."
  ],
  "preview": {
    "video": "previews/mono-light.webm",
    "poster": "previews/mono-light.jpg"
  }
}
