{
  "$schema": "../../schema.json",
  "id": "waves-paper",
  "type": "background",
  "title": "Waves · paper",
  "summary": "Static line pattern configurable into textures ranging from sharp zigzags to smooth flowing waves, in paper.",
  "tags": [
    "background",
    "waves",
    "gentle",
    "dark",
    "paper"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "colorFront",
      "type": "color",
      "default": "#E9E4D8",
      "description": "foreground color",
      "group": "main"
    },
    {
      "name": "colorBack",
      "type": "color",
      "default": "#000000",
      "description": "background color behind the effect",
      "group": "main"
    },
    {
      "name": "shape",
      "type": "number",
      "default": 1,
      "description": "base pattern",
      "min": 0,
      "max": 3,
      "step": 0.015,
      "group": "main"
    },
    {
      "name": "frequency",
      "type": "number",
      "default": 0.5,
      "description": "Wave frequency, needs amplitude > 0",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "amplitude",
      "type": "number",
      "default": 0.4,
      "description": "Wave amplitude, at frequency = 0 it only shifts the lines",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "spacing",
      "type": "number",
      "default": 1.4,
      "description": "Space between every two wavy lines",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "group": "advanced"
    },
    {
      "name": "proportion",
      "type": "number",
      "default": 0.08,
      "description": "Blend point between front and back colors, 0.5 = equal distribution",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "softness",
      "type": "number",
      "default": 0.05,
      "description": "edge softness",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "scale",
      "type": "number",
      "default": 1,
      "description": "zoom of the pattern",
      "min": 0.01,
      "max": 4,
      "step": 0.01,
      "group": "main"
    }
  ],
  "install": {
    "kind": "shader-set",
    "entry": {
      "shader": "Waves",
      "props": {
        "colorFront": "#E9E4D8",
        "colorBack": "#000000",
        "shape": 1,
        "frequency": 0.5,
        "amplitude": 0.4,
        "spacing": 1.4,
        "proportion": 0.08,
        "softness": 0.05,
        "scale": 1
      },
      "motion": {
        "param": "amplitude",
        "from": 0.3,
        "to": 0.6
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\n// a full-frame element <div id=\"bg\"></div> behind everything:\nB.shader(s, '#bg', 'waves-paper');",
  "notes": [
    "Paper shader `Waves` (still).",
    "Breathes on `amplitude` from 0.3 to 0.6 so a still shader stays alive."
  ],
  "preview": {
    "video": "previews/waves-paper.webm",
    "poster": "previews/waves-paper.jpg"
  },
  "colors": [
    "#e9e4d8",
    "#000000"
  ],
  "mode": "dark",
  "motion": "gentle",
  "mood": [
    "minimal",
    "editorial",
    "calm"
  ],
  "when": [
    "a field that breathes behind a title or a card",
    "a dark minimal piece"
  ]
}
