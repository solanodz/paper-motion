{
  "$schema": "../../schema.json",
  "id": "halftone-ochre",
  "type": "background",
  "title": "Halftone Dots · ochre holes",
  "summary": "A halftone-dot image filter featuring customizable grids, color palettes, and dot styles, in ochre holes.",
  "tags": [
    "background",
    "halftone-dots",
    "still",
    "light",
    "image",
    "ochre"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "contrast",
      "type": "number",
      "default": 0.6,
      "description": "contrast",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "originalColors",
      "type": "boolean",
      "default": false,
      "description": "Use sampled image's original colors instead of colorFront",
      "group": "advanced"
    },
    {
      "name": "inverted",
      "type": "boolean",
      "default": false,
      "description": "Inverts the image luminance, doesn't affect the color scheme, needs contrast > 0",
      "group": "advanced"
    },
    {
      "name": "grid",
      "type": "enum",
      "default": "square",
      "options": [
        "square",
        "hex"
      ],
      "description": "Grid type (0 = square, 1 = hex)",
      "group": "advanced"
    },
    {
      "name": "radius",
      "type": "number",
      "default": 1.1,
      "description": "radius",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "size",
      "type": "number",
      "default": 0.6,
      "description": "dot or pattern size",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "scale",
      "type": "number",
      "default": 1,
      "description": "zoom of the pattern",
      "min": 0.1,
      "max": 4,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "grainMixer",
      "type": "number",
      "default": 0.2,
      "description": "grain mixed into the colors",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "grainOverlay",
      "type": "number",
      "default": 0.2,
      "description": "grain laid over the image",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "grainSize",
      "type": "number",
      "default": 0.5,
      "description": "grain size",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "type",
      "type": "enum",
      "default": "holes",
      "options": [
        "classic",
        "gooey",
        "holes",
        "soft"
      ],
      "description": "variant",
      "group": "advanced"
    },
    {
      "name": "fit",
      "type": "string",
      "default": "cover",
      "description": "How to fit the rendered shader into the canvas dimensions (0 = none, 1 = contain, 2 = cover)",
      "group": "advanced"
    },
    {
      "name": "colorFront",
      "type": "color",
      "default": "#7A5A24",
      "description": "foreground color",
      "group": "main"
    },
    {
      "name": "colorBack",
      "type": "color",
      "default": "#00000000",
      "description": "background color behind the effect",
      "group": "main"
    }
  ],
  "install": {
    "kind": "shader-set",
    "entry": {
      "shader": "HalftoneDots",
      "props": {
        "contrast": 0.6,
        "originalColors": false,
        "inverted": false,
        "grid": "square",
        "radius": 1.1,
        "size": 0.6,
        "scale": 1,
        "image": "https://app.paper.design/file-assets/01M6SRQNT8A40GRN1N12WDCCM2/01M6SSXH0VAPZM08QX2B3B73SB.png",
        "grainMixer": 0.2,
        "grainOverlay": 0.2,
        "grainSize": 0.5,
        "type": "holes",
        "fit": "cover",
        "colorFront": "#7A5A24",
        "colorBack": "#00000000"
      },
      "background": "#EFE6CC"
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\n// a full-frame element <div id=\"bg\"></div> behind everything:\nB.shader(s, '#bg', 'halftone-ochre');",
  "notes": [
    "Paper shader `HalftoneDots` (still). Tuned by hand in Paper.",
    "Its image is a remote URL; swap `image` for your own picture."
  ],
  "preview": {
    "video": "previews/halftone-ochre.webm",
    "poster": "previews/halftone-ochre.jpg"
  }
}
