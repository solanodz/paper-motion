{
  "$schema": "../../schema.json",
  "id": "gem-smoke",
  "type": "background",
  "title": "Gem Smoke",
  "summary": "Animated color fields placed over uploaded logo shape.",
  "tags": [
    "background",
    "gem-smoke",
    "lively",
    "dark",
    "image"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "fit",
      "type": "string",
      "default": "contain",
      "description": "How to fit the rendered shader into the canvas dimensions (0 = none, 1 = contain, 2 = cover)",
      "group": "advanced"
    },
    {
      "name": "scale",
      "type": "number",
      "default": 0.8,
      "description": "zoom of the pattern",
      "min": 0.1,
      "max": 4,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "shape",
      "type": "enum",
      "default": "none",
      "options": [
        "none",
        "circle",
        "daisy",
        "diamond",
        "metaballs"
      ],
      "description": "base pattern",
      "group": "advanced"
    },
    {
      "name": "colorBack",
      "type": "color",
      "default": "#000000",
      "description": "background color behind the effect",
      "group": "main"
    },
    {
      "name": "colorInner",
      "type": "color",
      "default": "#141414",
      "description": "Additional color inside the input shape, mixing with smoke (RGBA)",
      "group": "advanced"
    },
    {
      "name": "colors",
      "type": "colors",
      "default": [
        "#8EA3AD",
        "#E9E4D8"
      ],
      "description": "palette colors (hex)",
      "maxItems": 6,
      "group": "main"
    },
    {
      "name": "outerGlow",
      "type": "number",
      "default": 0.55,
      "description": "Visibility of smoke shape outside the input shape",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "innerGlow",
      "type": "number",
      "default": 1,
      "description": "Visibility of smoke shape inside the input shape",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "innerDistortion",
      "type": "number",
      "default": 0.8,
      "description": "Power of smoke distortion inside the input shape, needs innerGlow > 0",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "outerDistortion",
      "type": "number",
      "default": 0.6,
      "description": "Power of smoke distortion outside the input shape, needs outerGlow > 0",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "size",
      "type": "number",
      "default": 0.8,
      "description": "dot or pattern size",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "animation speed (0 = still)",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "group": "main"
    }
  ],
  "install": {
    "kind": "shader-set",
    "entry": {
      "shader": "GemSmoke",
      "props": {
        "fit": "contain",
        "scale": 0.8,
        "shape": "none",
        "colorBack": "#000000",
        "colorInner": "#141414",
        "colors": [
          "#8EA3AD",
          "#E9E4D8"
        ],
        "outerGlow": 0.55,
        "innerGlow": 1,
        "innerDistortion": 0.8,
        "outerDistortion": 0.6,
        "size": 0.8,
        "speed": 1
      },
      "image": "wordmark"
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\n// a full-frame element <div id=\"bg\"></div> behind everything:\nB.shader(s, '#bg', 'gem-smoke');",
  "notes": [
    "Paper shader `GemSmoke` (animated).",
    "Needs the brand wordmark (brand/tokens.json wordmark files; `pamo wordmark` makes them)."
  ],
  "preview": {
    "video": "previews/gem-smoke.webm",
    "poster": "previews/gem-smoke.jpg"
  },
  "colors": [
    "#8ea3ad",
    "#e9e4d8",
    "#000000"
  ],
  "mode": "dark",
  "motion": "lively",
  "mood": [
    "luxury"
  ],
  "when": [
    "a hero moment where the material is the message",
    "a dark luxury piece",
    "you have a photo or a logo to run through it"
  ]
}
