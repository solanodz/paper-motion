{
  "$schema": "../../schema.json",
  "id": "heatmap",
  "type": "background",
  "title": "Heatmap",
  "summary": "A glowing gradient of colors flowing through an input shape.",
  "tags": [
    "background",
    "heatmap",
    "lively",
    "dark",
    "image"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "fit",
      "type": "string",
      "default": "contain",
      "description": "How to fit the rendered shader into the canvas dimensions (0 = none, 1 = contain, 2 = cover)",
      "group": "advanced"
    },
    {
      "name": "scale",
      "type": "number",
      "default": 0.8,
      "description": "zoom of the pattern",
      "min": 0.1,
      "max": 4,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "colorBack",
      "type": "color",
      "default": "#000000",
      "description": "background color behind the effect",
      "group": "main"
    },
    {
      "name": "colors",
      "type": "colors",
      "default": [
        "#3E4E57",
        "#6F8794",
        "#A9B8BE",
        "#E9E4D8",
        "#C9A65A",
        "#B07D73",
        "#ffffff"
      ],
      "description": "palette colors (hex)",
      "maxItems": 10,
      "group": "main"
    },
    {
      "name": "contour",
      "type": "number",
      "default": 0.5,
      "description": "Heat intensity near the edges of the input shape",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "angle",
      "type": "number",
      "default": 0,
      "description": "Direction of the heatwaves in degrees, needs innerGlow or outerGlow > 0",
      "min": 0,
      "max": 360,
      "step": 1.8,
      "group": "main"
    },
    {
      "name": "noise",
      "type": "number",
      "default": 0.1,
      "description": "Grain applied across the entire graphic",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "innerGlow",
      "type": "number",
      "default": 0.5,
      "description": "Size of the heated area inside the input shape",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "outerGlow",
      "type": "number",
      "default": 0.5,
      "description": "Size of the heated area outside the input shape",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "advanced"
    },
    {
      "name": "speed",
      "type": "number",
      "default": 0.8,
      "description": "animation speed (0 = still)",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "group": "main"
    }
  ],
  "install": {
    "kind": "shader-set",
    "entry": {
      "shader": "Heatmap",
      "props": {
        "fit": "contain",
        "scale": 0.8,
        "colorBack": "#000000",
        "colors": [
          "#3E4E57",
          "#6F8794",
          "#A9B8BE",
          "#E9E4D8",
          "#C9A65A",
          "#B07D73",
          "#ffffff"
        ],
        "contour": 0.5,
        "angle": 0,
        "noise": 0.1,
        "innerGlow": 0.5,
        "outerGlow": 0.5,
        "speed": 0.8
      },
      "image": "wordmark-dark"
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\n// a full-frame element <div id=\"bg\"></div> behind everything:\nB.shader(s, '#bg', 'heatmap');",
  "notes": [
    "Paper shader `Heatmap` (animated).",
    "Needs the brand wordmark (brand/tokens.json wordmark files; `pamo wordmark` makes them)."
  ],
  "preview": {
    "video": "previews/heatmap.webm",
    "poster": "previews/heatmap.jpg"
  },
  "colors": [
    "#3e4e57",
    "#6f8794",
    "#a9b8be",
    "#e9e4d8",
    "#c9a65a"
  ],
  "mode": "dark",
  "motion": "lively",
  "mood": [
    "technical",
    "bold"
  ],
  "when": [
    "a hero moment where the material is the message",
    "a dark technical piece",
    "you have a photo or a logo to run through it"
  ]
}
