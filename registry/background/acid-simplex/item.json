{
  "$schema": "../../schema.json",
  "id": "acid-simplex",
  "type": "background",
  "title": "Simplex Noise · acid",
  "summary": "A multi-color gradient mapped into smooth, animated curves built as a combination of 2 Simplex noises, in acid.",
  "tags": [
    "background",
    "simplex-noise",
    "gentle",
    "light",
    "acid"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "params": [
    {
      "name": "speed",
      "type": "number",
      "default": 0.5,
      "description": "animation speed (0 = still)",
      "min": 0,
      "max": 3,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "scale",
      "type": "number",
      "default": 0.6,
      "description": "zoom of the pattern",
      "min": 0.01,
      "max": 4,
      "step": 0.01,
      "group": "main"
    },
    {
      "name": "stepsPerColor",
      "type": "number",
      "default": 2,
      "description": "Number of extra colors between base colors, 1 = N colors, 2 = 2×N, etc., needs 2+ colors",
      "min": 1,
      "max": 10,
      "step": 0.045,
      "group": "main"
    },
    {
      "name": "softness",
      "type": "number",
      "default": 0,
      "description": "edge softness",
      "min": 0,
      "max": 1,
      "step": 0.005,
      "group": "main"
    },
    {
      "name": "colors",
      "type": "colors",
      "default": [
        "#F7FA81",
        "#7C9E25",
        "#FFDE66",
        "#53C953",
        "#97FFD7"
      ],
      "description": "palette colors (hex)",
      "maxItems": 10,
      "group": "main"
    }
  ],
  "install": {
    "kind": "shader-set",
    "entry": {
      "shader": "SimplexNoise",
      "props": {
        "speed": 0.5,
        "scale": 0.6,
        "stepsPerColor": 2,
        "softness": 0,
        "colors": [
          "#F7FA81",
          "#7C9E25",
          "#FFDE66",
          "#53C953",
          "#97FFD7"
        ]
      }
    }
  },
  "files": [],
  "requires": {
    "engine": ">=0.2.0"
  },
  "usage": "import { loadBrand } from 'paper-motion/brand';\n\nconst B = await loadBrand();\n// a full-frame element <div id=\"bg\"></div> behind everything:\nB.shader(s, '#bg', 'acid-simplex');",
  "notes": [
    "Paper shader `SimplexNoise` (animated). Tuned by hand in Paper."
  ],
  "preview": {
    "video": "previews/acid-simplex.webm",
    "poster": "previews/acid-simplex.jpg"
  },
  "colors": [
    "#f7fa81",
    "#7c9e25",
    "#ffde66",
    "#53c953",
    "#97ffd7"
  ],
  "mode": "light",
  "motion": "gentle",
  "mood": [
    "playful",
    "bold"
  ],
  "when": [
    "a field that breathes behind a title or a card",
    "a light playful piece"
  ]
}
